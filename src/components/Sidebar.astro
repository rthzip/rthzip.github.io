---
import FolderMenu from './FolderMenu.astro';
import SidebarProfile from './SidebarProfile.astro';
import { getFolders, getPublishedPosts } from '../blog';

interface Props {
  activeCategory?: string[];
}

const { activeCategory } = Astro.props;
const posts = await getPublishedPosts();
const folders = getFolders(posts);
const currentPath = decodeURIComponent(Astro.url.pathname).replace(/\/?$/, '/');
const activePath = activeCategory?.join('/');
---

<aside class="sidebar">
  <SidebarProfile />

  <nav class="blog-nav" aria-label="블로그 메뉴">
    <a class="nav-item home" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
      <span class="feed-icon" aria-hidden="true"></span>
      Home
      <span class="total" aria-label={`글 ${posts.length}개`}>{posts.length}</span>
    </a>
    {folders.length > 0 && (
      <div class="folder-group">
        <p class="menu-label">글 폴더</p>
        <FolderMenu {folders} {currentPath} {activePath} />
      </div>
    )}
  </nav>
</aside>

<style is:inline>
  .sidebar {
    min-width: 0;
  }

  .blog-nav ul { list-style: none; padding: 0; margin: 0; }
  .blog-nav { margin-top: 0.85rem; }
  .blog-nav .folder-group { margin-top: 1.1rem; }

  .blog-nav .menu-label {
    margin: 0 0 0.35rem;
    padding-inline: 0.7rem;
    color: var(--ink-faint);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .blog-nav .nav-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.45rem;
    padding: 0.3rem 0.7rem;
    border-radius: 0.4rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .blog-nav .nav-item:hover { color: var(--ink); }
  .blog-nav .nav-item.home { font-weight: 600; }

  .blog-nav .nav-item.active-folder,
  .blog-nav .nav-item[aria-current='page'] {
    color: var(--accent);
    font-weight: 700;
  }

  .blog-nav .total {
    margin-left: auto;
    color: var(--ink-faint);
    font: 0.7rem var(--font-sans);
    font-variant-numeric: tabular-nums;
  }

  .blog-nav .folder-children {
    margin-left: 1.08rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--rule);
  }

  .blog-nav .folder-children .folder-children {
    margin-left: var(--step--1);
    padding-left: 0;
    border-left: 0;
  }

  .blog-nav .child { min-height: 2.25rem; }

  .blog-nav :is(.feed-icon, .folder-icon) {
    position: relative;
    flex: 0 0 0.85rem;
    height: 0.68rem;
    border: 1px solid currentColor;
    border-radius: 0.12rem;
    color: var(--accent-muted);
  }

  .blog-nav :is(.feed-icon, .folder-icon)::before {
    position: absolute;
    content: '';
    border-top: 1px solid currentColor;
  }

  .blog-nav .feed-icon::before { inset: 0.18rem 0.13rem auto; }
  .blog-nav .folder-icon::before { top: -0.19rem; left: 0; width: 0.39rem; }

  @media (min-width: 52rem) {
    .sidebar { position: sticky; top: 1.5rem; }
  }
</style>
