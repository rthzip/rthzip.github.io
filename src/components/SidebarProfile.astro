---
import { SITE } from '../consts';
---

<section class="profile" aria-label="프로필">
  <p class="name">{SITE.author}</p>
  <p class="handle">@{SITE.handle}</p>
  <p class="bio">{SITE.description}</p>
  <ul class="socials">
    <li><a href={SITE.github}>GitHub <span aria-hidden="true">↗</span></a></li>
    <li><a href={SITE.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></li>
  </ul>
</section>

<style is:inline>
  .profile {
    padding: 0 0.7rem 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .profile .name { margin: 0; font-weight: 700; line-height: 1.35; text-transform: capitalize; }
  .profile .handle { margin: 0.15rem 0 0; color: var(--ink-faint); font-size: 0.78rem; }
  .profile .bio { margin: 0.65rem 0 0.5rem; font-size: var(--step--1); color: var(--ink-soft); }

  .profile .socials {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    gap: 0.45rem 1.15rem;
    font-size: 0.81rem;
    font-weight: 500;
  }

  .profile .socials span { color: var(--accent-muted); }
  .profile .socials a:hover { color: var(--accent); }
</style>
