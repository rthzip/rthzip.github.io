---
import { SITE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => {
  if (path === href) return 'page';
  const inSection = href === '/' ? /^\/(posts|categories)\//.test(path) : path.startsWith(href);
  return inSection ? 'location' : undefined;
};
---

<header class="masthead">
  <div class="shell bar">
    <a href="/" class="wordmark" aria-current={path === '/' ? 'page' : undefined}>{SITE.handle}<span aria-hidden="true">.</span></a>
    <nav aria-label="주요">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 3vw, 1.75rem);
    padding-block: 0.9rem;
  }

  .wordmark {
    font: 700 1.2rem var(--font-sans);
    letter-spacing: -0.03em;
    margin-right: auto;
  }

  .wordmark span { color: var(--accent); }

  nav ul {
    display: flex;
    gap: clamp(0.65rem, 2.5vw, 1.1rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  nav a {
    color: var(--ink-soft);
    padding-bottom: 0.2rem;
    border-bottom: 1.5px solid transparent;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
</style>
