---

---

<button type="button" class="toggle" data-theme-toggle aria-pressed="false">
  <span class="glyph" aria-hidden="true"></span>
  <span class="label">다크 모드</span>
</button>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink-faint);
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--seal);
  }

  .glyph {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: linear-gradient(to right, currentColor 50%, transparent 50%);
  }

  .label {
    /* 좁은 화면에서는 글리프만 남긴다. */
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 34rem) {
    .label {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-theme-toggle]');
    if (!button) return;

    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      button.setAttribute('aria-pressed', String(dark));
      button.querySelector('.label').textContent = dark ? '라이트 모드' : '다크 모드';
    };

    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });

    sync();
  })();
</script>
