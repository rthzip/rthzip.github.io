---

<button type="button" class="toggle" data-theme-toggle aria-label="다크 모드로 전환">
  <span class="moon" aria-hidden="true"></span>
  <span class="sun" aria-hidden="true"></span>
</button>

<style>
  .toggle {
    display: grid;
    place-items: center;
    flex: 0 0 2rem;
    width: 2rem;
    height: 2rem;
    background: none;
    border: 0;
    border-radius: 0.3rem;
    padding: 0;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .toggle:hover {
    background: var(--surface);
    color: var(--ink);
  }

  .moon {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: currentColor;
    mask-image: radial-gradient(circle at 71% 31%, transparent 48%, black 52%);
  }

  .sun {
    position: relative;
    display: none;
    width: 1.15rem;
    height: 1.15rem;
  }

  .sun::before,
  .sun::after {
    content: '';
    position: absolute;
    border-radius: 50%;
  }

  .sun::before {
    inset: 0;
    background: repeating-conic-gradient(from -6deg, currentColor 0deg 12deg, transparent 12deg 45deg);
    mask-image: radial-gradient(circle closest-side, transparent 66%, black 68%);
  }

  .sun::after {
    inset: 26%;
    border: 1.5px solid currentColor;
  }

  :global(html[data-theme='dark']) .moon {
    display: none;
  }

  :global(html[data-theme='dark']) .sun {
    display: block;
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-theme-toggle]');
    if (!button) return;

    const sync = () => {
      const next = document.documentElement.dataset.theme === 'dark' ? '라이트' : '다크';
      button.setAttribute('aria-label', `${next} 모드로 전환`);
    };

    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });

    sync();
  })();
</script>
