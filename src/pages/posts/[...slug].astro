---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostToc from '../../components/PostToc.astro';
import '../../styles/post-content.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const ordered = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return ordered.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: ordered[index - 1] ?? null,
      older: ordered[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer: CollectionEntry<'blog'> | null;
  older: CollectionEntry<'blog'> | null;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={post.data.title} description={post.data.description ?? undefined} ogType="article" activeCategory={post.data.category}>
  <div class="post-frame">
    <article class:list={['post', { 'has-toc': sections.length > 0 }]}>
      <header class="head">
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="desc">{post.data.description}</p>}
        <p class="when">
          <FormattedDate date={post.data.pubDate} />
          {post.data.updatedDate && <span class="revised">{' '}고침 <FormattedDate date={post.data.updatedDate} /></span>}
        </p>
        {
          post.data.tags.length > 0 && (
            <ul class="tag-row">
              {post.data.tags.map((tag) => (
                <li>
                  <a href={`/tags/${tag}/`}>{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        sections.length > 0 && (
          <>
            <div class="toc-side">
              <p class="toc-title">목차</p>
              <PostToc {sections} />
            </div>
            <details class="toc-mobile">
              <summary>목차</summary>
              <PostToc {sections} />
            </details>
          </>
        )
      }

      <div class="prose post-content">
        <Content />
      </div>
    </article>
  </div>

  {
    (newer || older) && (
      <nav class="around" aria-label="다른 글">
        {older && (
          <a class="step" href={`/posts/${older.id}/`}>
            <span class="step-label">이전 글</span>
            <span class="step-title">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a class="step next" href={`/posts/${newer.id}/`}>
            <span class="step-label">다음 글</span>
            <span class="step-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>

<style>
  .post-frame {
    container-type: inline-size;
  }

  .head {
    max-width: var(--measure);
    margin-bottom: 2.2rem;
  }

  .head h1 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .desc {
    margin: 0.7rem 0 0;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .when {
    margin: 1.4rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .revised::before {
    content: '';
    display: inline-block;
    width: 1.6rem;
    border-top: 1px solid var(--rule);
    vertical-align: middle;
    margin-right: 0.5rem;
  }

  .tag-row {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .toc-side {
    display: none;
  }

  .toc-mobile {
    max-width: var(--measure);
    margin-bottom: 1.5rem;
    padding-block: 0.45rem;
    border-block: 1px solid var(--rule);
  }

  .toc-mobile summary {
    cursor: pointer;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .toc-mobile[open] summary {
    margin-bottom: 0.6rem;
  }

  .toc-title {
    margin: 0 0 0.55rem;
    color: var(--ink-faint);
    font-size: var(--step--1);
    font-weight: 600;
  }

  @container (min-width: 29rem) {
    .post.has-toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(7rem, 23cqi, 10.75rem);
      column-gap: clamp(1rem, 4cqi, 2rem);
    }

    .head { grid-area: 1 / 1; }
    .prose { grid-area: 2 / 1; }
    .toc-mobile { display: none; }

    .toc-side {
      display: block;
      grid-area: 1 / 2 / 3;
      align-self: start;
      position: sticky;
      inset-block-start: 1.5rem;
      max-height: calc(100dvh - 3rem);
      overflow-y: auto;
      padding: 0.15rem 0.25rem 0.3rem 0.85rem;
      border-left: 1px solid var(--rule);
    }
  }

  .around {
    display: grid;
    gap: 1px;
    margin-top: 4rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .step {
    display: block;
    padding: 1.3rem 0;
  }

  .step + .step {
    border-top: 1px solid var(--rule);
  }

  .step-label {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .step-title {
    display: block;
    margin-top: 0.15rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .step:hover .step-title {
    color: var(--accent);
  }

  @media (min-width: 44rem) {
    .around {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }

    .step + .step {
      border-top: 0;
    }

    .next {
      grid-column: 2;
      text-align: right;
    }
  }
</style>
