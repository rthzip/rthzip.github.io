---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of new Set(post.data.tags)) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const byName = new Intl.Collator('ko', { numeric: true, sensitivity: 'base' });
const tags = [...counts].sort(([a], [b]) => byName.compare(a, b));
---

<BaseLayout title="Tags" description="주제별로 모아 둔 글 목록" showSidebar={false}>
  <section class="tag-index" aria-labelledby="tag-index-title">
    <header class="tag-index-header">
      <h1 class="section-title" id="tag-index-title">Tags</h1>
      {tags.length > 0 && <span class="tag-index-total">{tags.length}개</span>}
    </header>
    {tags.length === 0 ? (
      <p class="tag-index-empty">아직 태그가 붙은 글이 없습니다.</p>
    ) : (
      <ul class="tag-index-list">
        {tags.map(([tag, count]) => (
          <li>
            <a href={`/tags/${tag}/`} aria-label={`${tag}, 글 ${count}개`}>
              <span class="tag-entry-name">
                <span class="tag-entry-hash" aria-hidden="true">#</span>
                <span>{tag}</span>
              </span>
              <span class="tag-entry-count">글 {count}개</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style is:inline>
  .tag-index {
    container-type: inline-size;
  }

  .tag-index-header {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 1.4rem;
  }

  .tag-index-total,
  .tag-entry-count,
  .tag-index-empty {
    color: var(--ink-faint);
    font-size: var(--step--1);
  }

  .tag-index-list {
    display: grid;
    column-gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-index-list li {
    border-bottom: 1px solid var(--rule);
  }

  .tag-index-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.7rem;
    padding-block: 0.75rem;
  }

  .tag-entry-name {
    display: flex;
    align-items: baseline;
    gap: 0.28em;
    font-size: var(--step-0);
    font-weight: 650;
  }

  .tag-entry-hash {
    color: var(--accent);
    font-weight: 500;
  }

  .tag-index-list a:is(:hover, :focus-visible) .tag-entry-name {
    color: var(--accent);
  }

  .tag-entry-count {
    flex: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @container (min-width: 34rem) {
    .tag-index-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
